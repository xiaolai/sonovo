/.swiftpm/*
!/.swiftpm/xcode
/.swiftpm/xcode/*
!/.swiftpm/xcode/xcshareddata
/build/
/DerivedData/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.xcarchive
*.dSYM/
*.app
*.dmg
*.pkg
*.ipa
*.xcresult/
TestResults/
coverage/

# Local machine settings and release credentials, never source.
.env
.env.*
!.env.example
local.mk
